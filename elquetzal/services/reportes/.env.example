# Copiar a ".env" en esta misma carpeta y llenar el password real
# (debe ser igual a REPORTES_DB_PASSWORD en el .env de la raíz de elquetzal/).
DB_HOST=db
DB_PORT=5432
DB_NAME=reportes_db
DB_USER=reportes_user
DB_PASSWORD=cambiar_password_reportes

# Credenciales de lectura para generar el reporte consolidado
CATALOGO_DB_NAME=catalogo_db
CATALOGO_DB_USER=catalogo_user
CATALOGO_DB_PASSWORD=cambiar_password_catalogo
INVENTARIO_DB_NAME=inventario_db
INVENTARIO_DB_USER=inventario_user
INVENTARIO_DB_PASSWORD=cambiar_password_inventario
PEDIDOS_DB_NAME=pedidos_db
PEDIDOS_DB_USER=pedidos_user
PEDIDOS_DB_PASSWORD=cambiar_password_pedidos
