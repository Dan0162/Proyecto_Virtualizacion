# Copiar a ".env" (en la misma carpeta que docker-compose.yml) y llenar
# valores reales. ".env" no se commitea (ver .gitignore).

# Docker Hub del grupo (Área 3)
DOCKERHUB_USER=cambiar_usuario_dockerhub
TAG=latest

# Superusuario de Postgres (solo administra el motor, no lo usan los servicios)
PG_SUPERUSER=postgres
PG_SUPERUSER_PASSWORD=cambiar_password_super

# Contraseña por microservicio (Área 4). Cada valor debe coincidir con
# DB_PASSWORD en services/<servicio>/.env — ver .env.example de cada servicio.
CATALOGO_DB_PASSWORD=cambiar_password_catalogo
INVENTARIO_DB_PASSWORD=cambiar_password_inventario
CLIENTES_DB_PASSWORD=cambiar_password_clientes
PEDIDOS_DB_PASSWORD=cambiar_password_pedidos
REPORTES_DB_PASSWORD=cambiar_password_reportes
