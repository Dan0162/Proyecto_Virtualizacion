# --- Docker Hub ---
# Usuario/organización del grupo en Docker Hub. Las imágenes se publican como:
#   docker.io/<DOCKERHUB_USER>/elquetzal-<servicio>:<TAG>
DOCKERHUB_USER=tu_usuario_dockerhub
TAG=latest

# --- Postgres (superusuario del motor, solo para administración) ---
PG_SUPERUSER=postgres
PG_SUPERUSER_PASSWORD=cambia_esta_clave_super
